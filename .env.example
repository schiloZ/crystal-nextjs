# Base MySQL (variable DATABASE_ONLINE, lue par prisma/schema.prisma) : compte dédié (jamais root), connexion chiffrée en dehors du poste local.
# Exemple distant : mysql://crystal_app:MOT_DE_PASSE@hote:3306/crystal?sslaccept=strict&connection_limit=10
DATABASE_ONLINE="mysql://crystal_app:change-me@localhost:3306/crystal"

# Secret de signature des sessions : unique par environnement, jamais commité.
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Requis derrière un reverse proxy (production).
# AUTH_TRUST_HOST=true

# Domaines autorisés pour les Server Actions, séparés par des virgules.
ALLOWED_ORIGINS="localhost:3000"

# Assistant IA : appels externes désactivés par défaut (données de santé).
# Ne passer à true qu'après validation DPO et contrat avec le fournisseur.
ASSISTANT_AI_EXTERNAL=false
# GROQ_API_KEY=
# GROQ_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# URL publique de l'application, utilisée dans les liens envoyés par e-mail.
# APP_URL="https://crystal-nextjs.vercel.app"

# Envoi des e-mails (mot de passe oublié). Sans ces variables, en développement,
# le lien s'affiche dans la console du serveur.
# Gmail SMTP (prioritaire) : SMTP_PASS est un « mot de passe d'application » Google
# (Compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications).
# SMTP_USER="votre.adresse@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_HOST="smtp.gmail.com"   (par défaut)
# SMTP_PORT=465                (par défaut)
# Brevo (https://brevo.com) : fonctionne sans nom de domaine, avec une adresse vérifiée.
# BREVO_API_KEY=
# Ou Resend (https://resend.com) : exige un domaine vérifié.
# RESEND_API_KEY=
# Adresse expéditrice, identique à celle vérifiée chez le fournisseur.
# EMAIL_FROM="CRYSTAL <votre.adresse@gmail.com>"
